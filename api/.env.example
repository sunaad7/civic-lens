# Server
NODE_ENV=development
PORT=3001

# Postgres (local docker: postgres://civiclens:civiclens@localhost:5432/civiclens)
DATABASE_URL=postgresql://localhost:5432/civiclens
# test DB used by `npm test` (defaults to <DATABASE_URL with db name civiclens_test>)
TEST_DATABASE_URL=

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173

# Reverse proxy hops to trust for client IP (set to 1 when behind Render/Vercel/etc.)
TRUST_PROXY=0
# Refresh-cookie SameSite. Leave unset for "lax" in dev; use "none" when the web app
# is served from a different site than the API (e.g. Vercel web + Render API).
# COOKIE_SAMESITE=none

# AI provider: "stub" is the only option without an API key
AI_PROVIDER=stub

# Supabase Storage (optional — if unset, images are stored on local disk)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=complaint-images

# Local image storage (used when Supabase is not configured)
UPLOAD_DIR=uploads
API_PUBLIC_URL=http://localhost:3001

# Seed admin (npm run seed)
ADMIN_EMAIL=admin@civiclens.local
ADMIN_PASSWORD=admin1234
